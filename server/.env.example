# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (include the database name, e.g. /pool-in)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pool-in?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_DAYS=7

# Optional: use if the server logs "querySrv EBADRESP" when connecting to Atlas
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173

# SMS for phone OTP. "console" prints codes in the server terminal (development only; refused in production).
SMS_PROVIDER=console

# Feature flags
ENABLE_PAID_PRIVATE_RIDES=false
