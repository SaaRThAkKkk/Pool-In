# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (include the database name, e.g. /pool-in)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pool-in?retryWrites=true&w=majority

# Pools are stored in a separate database on the same cluster (users stay in the database named in MONGODB_URI).
# It is created automatically on first write. Your Atlas database user needs read/write access to it too.
POOLS_DB_NAME=pool-in-pools

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_DAYS=7

# Optional: use if the server logs "querySrv EBADRESP" when connecting to Atlas
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173

# SMS for phone OTP. "console" prints codes in the server terminal (development only; refused in production).
SMS_PROVIDER=console

# Place search and routing. These defaults are free public demo servers with fair-use limits
# (development only). Point them at your own instances or a paid provider before real traffic.
# PHOTON_URL=https://photon.komoot.io
# OSRM_URL=https://router.project-osrm.org
# MAPS_USER_AGENT=Pool-In/0.1 (contact: you@example.com)

# Block booking/joining rides for users whose phone is not verified (currently off)
REQUIRE_VERIFIED_PHONE_FOR_BOOKING=false

# Feature flags
ENABLE_PAID_PRIVATE_RIDES=false
